# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.eggs/

# Model files (too large for git - use Git LFS or HuggingFace Hub)
models/phishing_model/*
!models/phishing_model/.gitkeep
models/phishing_model.zip

# Virtual environments
venv/
.venv/
env/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter checkpoints
.ipynb_checkpoints/

# Streamlit (keep the deployed config, never commit credentials)
.streamlit/secrets.toml
.streamlit/credentials.toml

# Evaluation outputs
evaluation/figures/*
evaluation/reports/*
!evaluation/figures/.gitkeep
!evaluation/reports/.gitkeep

# SHAP outputs
explainability/outputs/*
!explainability/outputs/.gitkeep

# Dataset (regenerate from script)
dataset/dataset.csv
dataset/dataset_metadata.csv
dataset/preprocessed_dataset.csv

# Experiment outputs (regenerate from scripts)
experiments/template_aware_split/data/
experiments/template_aware_split/models/
experiments/template_aware_split/reports/*
experiments/template_aware_split/figures/*
!experiments/template_aware_split/reports/.gitkeep
!experiments/template_aware_split/figures/.gitkeep

# Logs
*.log